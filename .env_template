# Orchestration mode:
#   llm           - multi-agent LLM forecasting (needs API key)
#   deterministic - classic model selection only, no LLM API
ORCHESTRATION_MODE=llm

# Runtime tag for auto-archive naming (scripts/run.sh sets CASTMIND_RUNTIME=main).
CASTMIND_RUNTIME=main

# After Experiment Summary, copy outputs/<dataset> -> outputs/_archive/<tag> (overwrite).
# Tags: {dataset}_llm_<model_slug> | …
# CASTMIND_AUTO_ARCHIVE=0 to disable; CASTMIND_ARCHIVE_NAME=foo to force folder name.
CASTMIND_AUTO_ARCHIVE=1

# Author paper §4.1 uses GPT-5. This machine currently uses DeepSeek (temporary extra
# exception — disclose in thesis; do not claim Table 1 system-row match).
# When you have GPT-5 access, switch to:
#   OPENAI_BASE_URL="https://api.openai.com/v1"
#   MODEL="gpt-5"
OPENAI_BASE_URL="https://api.deepseek.com/v1"
OPENAI_API_KEY="sk-*****"
MODEL="deepseek-chat"

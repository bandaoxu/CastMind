# Orchestration mode:
#   llm           - multi-agent LLM forecasting (needs API key)
#   deterministic - classic model selection only, no LLM API
ORCHESTRATION_MODE=llm

# Runtime tag for auto-archive naming (main vs sundial side env).
# Side wrapper scripts/run_with_sundial_env.sh sets CASTMIND_RUNTIME=sundial.
CASTMIND_RUNTIME=main

# After Experiment Summary, copy outputs/<dataset> -> outputs/_archive/<tag> (overwrite).
# Tags: {dataset}_llm_deepseek | {dataset}_llm_sundial | {dataset}_*_deterministic
# CASTMIND_AUTO_ARCHIVE=0 to disable; CASTMIND_ARCHIVE_NAME=foo to force folder name.
CASTMIND_AUTO_ARCHIVE=1

# AlphaCast paper §4.1 uses GPT-5. This reproduction uses DeepSeek instead.
OPENAI_BASE_URL="https://api.deepseek.com/v1"
OPENAI_API_KEY="sk-*****"
MODEL="deepseek-chat"
